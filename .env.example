# On-chain (Polygon Amoy) - only needed to deploy/run against the public testnet
AMOY_RPC_URL=
PRIVATE_KEY=

# Off-chain IPFS (Pinata) - only needed for real IPFS uploads (demos use a mock by default)
PINATA_JWT=replace_with_your_pinata_jwt
PINATA_GATEWAY=replace_with_your_gateway.mypinata.cloud
DEMO_CREDENTIAL_PASSWORD=replace_with_demo_password
